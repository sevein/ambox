{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "detailed": {
      "format": "%(levelname)-8s %(threadName)s %(asctime)s %(module)s:%(funcName)s:%(lineno)d:  %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "level": "WARNING",
      "class": "logging.StreamHandler",
      "formatter": "detailed"
    }
  },
  "loggers": {
    "archivematica": {
      "level": "WARNING"
    }
  },
  "root": {
    "handlers": ["console"],
    "level": "WARNING"
  }
}

#!/command/execlineb -P

define DATA_DIR /var/lib/mysql

foreground { install -d -o mysql -g mysql -m 0775 /run/mysqld }

foreground { chown -R mysql:mysql ${DATA_DIR} }

# Initialize only if not already initialized.
foreground {
  if { test ! -d ${DATA_DIR}/mysql }
  foreground { echo "Initializing MySQL data directory..." }
  s6-setuidgid mysql mysqld --initialize-insecure --datadir=${DATA_DIR}
}

s6-setuidgid mysql
exec mysqld \
  --datadir=${DATA_DIR} \
  --skip-networking=0 \
  --character-set-server=utf8mb4 \
  --collation-server=utf8mb4_0900_ai_ci

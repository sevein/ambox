#!/command/execlineb -P

foreground {
  /usr/local/bin/wait-mysql.sh 60 0.5
}

foreground {
  mysql \
    --protocol=socket \
    --socket=/run/mysqld/mysqld.sock \
    --user=root \
    --execute="CREATE DATABASE IF NOT EXISTS SS;
CREATE DATABASE IF NOT EXISTS MCP;
CREATE USER IF NOT EXISTS 'archivematica'@'%' IDENTIFIED BY 'demo';
GRANT ALL PRIVILEGES ON SS.* TO 'archivematica'@'%';
GRANT ALL PRIVILEGES ON MCP.* TO 'archivematica'@'%';
FLUSH PRIVILEGES;"
}

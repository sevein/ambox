#!/command/execlineb -P

if { test -f /var/lib/mysql/.am_db_seeded } exit 0

s6-parallel
{
  /usr/local/bin/wait-mysql.sh 40 0.5
}
{
  s6-setuidgid archivematica
  /usr/local/bin/wait-http.sh http://127.0.0.1:8001/ 60 0.5
}

foreground {
  s6-envdir -f /etc/ambox/envs/dashboard
  s6-setuidgid archivematica
  foreground {
    cd /src /venv/bin/python \
      src/archivematica/dashboard/manage.py \
      migrate \
      --noinput
  }
  foreground {
    cd /src /venv/bin/python \
      src/archivematica/dashboard/manage.py \
      install \
      --username=test \
      --password=test \
      --email=test@test.com \
      --org-name=test \
      --org-id=test \
      --api-key=test \
      --ss-url=http://127.0.0.1:8001 \
      --ss-user=test \
      --ss-api-key=test \
      --site-url=http://127.0.0.1
  }
}
